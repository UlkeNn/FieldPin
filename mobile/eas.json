{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "autoIncrement": true,      
      "android": {
        "buildType": "apk",
        "distribution": "internal"
      },
      "ios": {
        "distribution": "store"    // TestFlight için "store" şart
      }

    },
    "production": {
      "autoIncrement": true,
      "android" : {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
