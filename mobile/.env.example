# Backend API base URL. Use your computer's LAN IP so a phone on the same network can reach it.
EXPO_PUBLIC_BASE_URL=http://192.168.1.10:5290

# Optional: plate recognition (ANPR) service. If empty, the backend path /api/anpr/recognize is used.
EXPO_PUBLIC_PLATE_OCR_URL=
EXPO_PUBLIC_PLATE_OCR_TOKEN=
EXPO_PUBLIC_PLATE_OCR_PATH=
